# Copy to .env.local to enable real AI responses in the /journal demo.
# Without this key, the app falls back to canned reflective prompts —
# it still works end-to-end, just without live model calls.
ANTHROPIC_API_KEY=

# Stripe: without STRIPE_SECRET_KEY, checkout buttons show a friendly
# "payments not configured yet" message instead of failing silently.
STRIPE_SECRET_KEY=

# Base URL used to build Stripe success/cancel redirect links.
# Defaults to the request origin if unset (fine for local dev).
NEXT_PUBLIC_BASE_URL=

# Stripe Price IDs — one per sellable product/plan. Create these in the
# Stripe Dashboard (Products > Add product > Add price) and paste the
# "price_..." id here. Leave unset to keep that item non-purchasable.
STRIPE_PRICE_AI_MOOD_JOURNAL=
STRIPE_PRICE_ANXIETY_TOOLKIT=
STRIPE_PRICE_CALM_SLEEP_SOUNDS=
STRIPE_PRICE_THERAPY_SESSION_PREP=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_ANNUAL=
