# Rinomina questo file in ".env" e compila i valori.

# Chiave API di Claude: https://platform.claude.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Token del bot Telegram: scrivi a @BotFather su Telegram -> /newbot
TELEGRAM_BOT_TOKEN=

# Il tuo ID Telegram (numero). Lascialo vuoto la prima volta: scrivi al bot
# e lui ti risponde col tuo ID, poi incollalo qui e riavvia.
TELEGRAM_ALLOWED_USER_ID=
